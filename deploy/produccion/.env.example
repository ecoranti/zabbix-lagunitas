# Copiar a deploy/produccion/.env y completar. Generar claves con:  openssl rand -base64 24
MYSQL_DATABASE=zabbix
MYSQL_USER=zabbix
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_INNODB_BUFFER=1G

ZBX_SERVER_NAME=Red Las Lagunitas
PHP_TZ=America/Argentina/Cordoba

# Nombre con el que se accede al frontend (DNS público, nombre interno o IP)
ZBX_DOMAIN=monitoreo.lagunitas.local
# internal = certificado propio para LAN/VPN; o un email para Let's Encrypt
CADDY_TLS=internal

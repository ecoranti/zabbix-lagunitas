# =============================================================================
#  Variables de entorno — copiar a .env y completar (.env NO se versiona)
# =============================================================================

# --- Base de datos (docker compose) -----------------------------------------
MYSQL_DATABASE=zabbix
MYSQL_USER=zabbix
MYSQL_PASSWORD=cambiar-esta-clave
MYSQL_ROOT_PASSWORD=cambiar-esta-clave-root

# --- Zabbix ------------------------------------------------------------------
ZBX_SERVER_NAME=Red Las Lagunitas
PHP_TZ=America/Argentina/Cordoba
ZABBIX_WEB_PORT=8090

# --- Provisionador (lagunitas) ----------------------------------------------
ZABBIX_URL=http://localhost:8090/api_jsonrpc.php
# Preferido: API token de un usuario Super admin (Users -> API tokens)
ZABBIX_API_TOKEN=
# Alternativa (solo LAB): usuario/clave
ZABBIX_USER=Admin
ZABBIX_PASSWORD=zabbix
ZABBIX_VERIFY_TLS=true
# Inventario a aprovisionar
LAGUNITAS_INVENTORY=config/inventory.lab.yaml

# --- Integraciones -----------------------------------------------------------
# API key de UniFi Network (Integrations -> Create API Key)
UNIFI_API_KEY=
# Comunidad SNMP de los equipos airMAX / Mikrotik (producción)
SNMP_COMMUNITY=
# Notificaciones por Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

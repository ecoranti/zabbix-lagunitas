#!/usr/bin/env bash
# Wrapper del CLI: crea el entorno virtual la primera vez y ejecuta el comando.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
if [ ! -x .venv/bin/python ]; then
  echo "Creando entorno virtual (.venv)..." >&2
  python3 -m venv .venv
  .venv/bin/pip install -q -r requirements.txt
fi
exec .venv/bin/python -m lagunitas "$@"
